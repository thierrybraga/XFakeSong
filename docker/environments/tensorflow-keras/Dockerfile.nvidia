# syntax=docker/dockerfile:1.7
# =====================================================================
# XFakeSong — ambiente de treino: tensorflow-keras (modelos neurais Keras, GPU)
# Requer NVIDIA Container Toolkit no host (Linux nativo ou Windows+WSL2).
# Mapa completo dos 5 ambientes: docker/environments/README.md
# =====================================================================
ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim

LABEL org.opencontainers.image.title="xfakesong-tensorflow-keras" \
      org.opencontainers.image.description="XFakeSong — treino TensorFlow/Keras (NVIDIA GPU)" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/thierrybraga/XFakeSong"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    TF_FORCE_GPU_ALLOW_GROWTH=true \
    MPLBACKEND=Agg \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-base.txt ./
RUN pip install --upgrade pip setuptools wheel \
    && pip install -r requirements-base.txt \
    && pip install 'tensorflow[and-cuda]>=2.16,<2.22' \
    && pip install --upgrade --no-deps 'nvidia-cudnn-cu12>=9.3.0.75,<10' \
    && pip install --no-deps 'nvidia-cuda-nvcc-cu12'

COPY . .

ENTRYPOINT ["tini", "--"]
CMD ["python", "scripts/training/train_by_family.py", "--family", "tensorflow-keras", "--help"]
