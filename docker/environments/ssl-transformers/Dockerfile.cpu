# syntax=docker/dockerfile:1.7
# =====================================================================
# XFakeSong — ambiente de treino: ssl-transformers (WavLM, HuBERT — backbone
# SSL real via PyTorch/Hugging Face)
# Mapa completo dos 5 ambientes: docker/environments/README.md
# =====================================================================
ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim

LABEL org.opencontainers.image.title="xfakesong-ssl-transformers" \
      org.opencontainers.image.description="XFakeSong — treino SSL WavLM/HuBERT (CPU)" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/thierrybraga/XFakeSong"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    HF_HOME=/app/cache/huggingface \
    TORCH_HOME=/app/cache/torch \
    MPLBACKEND=Agg

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-base.txt constraints.txt ./
COPY docker/environments/ssl-transformers/requirements.txt docker/environments/ssl-transformers/
ENV PIP_CONSTRAINT=/app/constraints.txt
RUN pip install --upgrade pip setuptools wheel \
    && pip install -r docker/environments/ssl-transformers/requirements.txt

COPY . .

ENTRYPOINT ["tini", "--"]
CMD ["python", "scripts/training/train_by_family.py", "--family", "ssl-transformers", "--help"]
