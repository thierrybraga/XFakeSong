# syntax=docker/dockerfile:1.7
# =====================================================================
# XFakeSong — ambiente de inferência: Gradio + FastAPI (NVIDIA GPU)
# Requer NVIDIA Container Toolkit no host (Linux nativo ou Windows+WSL2).
# Mapa completo dos 5 ambientes: docker/environments/README.md
# =====================================================================
ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim

ARG PYTHON_VERSION

LABEL org.opencontainers.image.title="xfakesong-inference-api" \
      org.opencontainers.image.description="XFakeSong — inferência Gradio/FastAPI (NVIDIA GPU)" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/thierrybraga/XFakeSong"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    TF_FORCE_GPU_ALLOW_GROWTH=true \
    GRADIO_ANALYTICS_ENABLED=False \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=7860 \
    MPLBACKEND=Agg \
    NUMBA_CACHE_DIR=/tmp/numba_cache \
    HF_HOME=/app/cache/huggingface \
    TORCH_HOME=/app/cache/torch \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# tensorflow[and-cuda] installs NVIDIA runtime libraries inside site-packages.
# Publish them to the dynamic loader so GPU discovery works without a manual
# LD_LIBRARY_PATH in docker compose or docker run.
ENV NVIDIA_PIP_LIBS=/usr/local/lib/python${PYTHON_VERSION}/site-packages/nvidia
ENV LD_LIBRARY_PATH=${NVIDIA_PIP_LIBS}/cuda_cupti/lib:${NVIDIA_PIP_LIBS}/cuda_nvrtc/lib:${NVIDIA_PIP_LIBS}/cusparse/lib:${NVIDIA_PIP_LIBS}/nccl/lib:${NVIDIA_PIP_LIBS}/cuda_runtime/lib:${NVIDIA_PIP_LIBS}/cudnn/lib:${NVIDIA_PIP_LIBS}/cufft/lib:${NVIDIA_PIP_LIBS}/cusolver/lib:${NVIDIA_PIP_LIBS}/cublas/lib:${NVIDIA_PIP_LIBS}/nvjitlink/lib:${NVIDIA_PIP_LIBS}/curand/lib

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        curl \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Usuário não-root (mesmo padrão já validado no antigo Dockerfile raiz)
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd --system --gid ${APP_GID} appuser && \
    useradd --system --uid ${APP_UID} --gid appuser --shell /bin/bash --create-home appuser

WORKDIR /app
COPY requirements-base.txt ./
COPY docker/environments/inference-api/requirements-torch.txt docker/environments/inference-api/
RUN pip install --upgrade pip setuptools wheel \
    && pip install -r requirements-base.txt \
    && pip install 'tensorflow[and-cuda]>=2.16,<2.22' \
    && pip install --upgrade --no-deps 'nvidia-cudnn-cu12>=9.3.0.75,<10' \
    && pip install --no-deps 'nvidia-cuda-nvcc-cu12' \
    && pip install -r docker/environments/inference-api/requirements-torch.txt

COPY docker/environments/inference-api/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

COPY . .
RUN mkdir -p /app/data/logs /app/data/models /app/data/datasets/fake /app/data/datasets/real \
        /tmp/numba_cache /tmp/matplotlib /tmp/huggingface /tmp/gradio \
    && chown -R appuser:appuser /app /tmp/numba_cache /tmp/matplotlib /tmp/huggingface /tmp/gradio

USER appuser

EXPOSE 7860

# start_period 180s: dá tempo do TF/Keras + carregamento dos 13 modelos
# terminar antes do primeiro health check contar como falha.
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
    CMD curl -fsSL -o /dev/null --max-time 5 \
            http://127.0.0.1:7860/api/v1/system/health \
        || curl -fsSL -o /dev/null --max-time 5 \
            http://127.0.0.1:7860/ \
        || exit 1

ENTRYPOINT ["tini", "--", "docker-entrypoint.sh"]
CMD ["python", "main.py", "--gradio", "--gradio-port", "7860"]

