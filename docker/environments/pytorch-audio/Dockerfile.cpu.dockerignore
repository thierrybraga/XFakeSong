*~
.DS_Store
Thumbs.db

# --- Logs / Temp ---
data/logs/
*.log
tmp/
temp/
data/results/

# --- Dados e modelos (montados em runtime — nunca baked-in em imagem de treino) ---
cache/
data/
datasets/
data/models/
models/

# --- Dev / docs (não necessários para treino) ---
docs/
mkdocs.yml
site/
notebooks/
*.ipynb
.ipynb_checkpoints/
tests/

# --- Claude / IA assist (memory local) ---
.claude/
CLAUDE.md

# --- Docker próprios ---
Dockerfile*
docker-compose*.yml
.dockerignore

# --- Env / secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- OS ---
.AppleDouble
