# Artefatos locais do SpeechChecker. O diretório de dados é ignorado por padrão;
# código de `tools/` e `benchmarks/`, catálogos pequenos e fontes do artigo entram no Git.
/data/
!/data/
/data/*
!/data/.gitkeep
!/benchmarks/
!/benchmarks/**
/benchmarks/**/__pycache__/
!/tools/
!/tools/**
/tools/**/__pycache__/

# Só o marcador da pasta de modelos é versionado. O registry.json é gerado pela
# promoção dos artefatos e guarda caminhos absolutos da máquina que o gerou.
!/data/models/
/data/models/*
!/data/models/.gitkeep

# Resultados de execução são locais; a fonte do artigo é versionada.
!/data/results/
/data/results/*
!/data/results/paper/
!/data/results/paper/**

# Saídas e cópias de trabalho regeneráveis do artigo.
/data/results/paper/*.pdf
/data/results/paper/*.aux
/data/results/paper/*.lof
/data/results/paper/*.lot
/data/results/paper/*.out
/data/results/paper/*.toc
/data/results/paper/*.log
/data/results/paper/*.synctex.gz
data/results/paper/**/*.bak
data/results/paper/**/*.antes
/data/results/paper/*.zip
/data/results/paper/final/

# Outros dados, caches e artefatos locais.
/data/cache/
/dataset_pt_deepfake*.zip
/*.npz
*.h5
*.stale-*.bak
*.stale.bak

