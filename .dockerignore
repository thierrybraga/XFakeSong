# ============================================================
# Docker build context exclusions (XFakeSong)
# Reduz tamanho do build context em ~95% e evita layer cache miss
# ============================================================

# --- VCS ---
.git/
.gitignore
.gitattributes
.github/
.gitlab-ci.yml

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv-wsl/
.venv_wsl/
venv/
env/
ENV/
.python-version
*.egg-info/
*.egg
.eggs/
build/
dist/
pip-wheel-metadata/

# --- Caches / Test artifacts ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
.cache/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs / Temp ---
data/logs/
*.log
tmp/
temp/
data/results/

# --- Data e modelos pesados (volumes montados em runtime) ---
# cache/ (HF Hub/Torch/TF) usa symlinks internos que o build context do
# Docker não consegue transferir de forma confiável ("invalid file request") —
# sempre montado via volume (../../cache/*:/app/cache/*), nunca baked-in.
cache/
data/
datasets/
data/models/*.keras
data/models/*.h5
data/models/*.pkl
data/models/*.onnx
data/models/*.tflite
data/models/optuna_trials/
data/models/benchmark_final/
models/

# --- Inferência empacotada: manter modelos finais treinados na imagem ---
!data/models/bench_*
!data/models/benchmark_final/
!data/models/benchmark_final/**
!data/models/wavlm_backbone/
!data/models/wavlm_backbone/**
!data/models/hubert_backbone/
!data/models/hubert_backbone/**

# --- Dev / docs (não necessários em produção) ---
docs/
mkdocs.yml
site/
notebooks/
*.ipynb
.ipynb_checkpoints/
tests/
benchmarks/

# --- Claude / IA assist (memory local) ---
.claude/
CLAUDE.md

# --- Docker próprios ---
Dockerfile*
docker-compose*.yml
.dockerignore

# --- Env / secrets ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- OS ---
.AppleDouble
.LSOverride
Icon?

# --- Misc ---
*.bak
*.tmp
*.zip
*.tar.gz
*.7z
mlruns/
.mlflow/
wandb/
