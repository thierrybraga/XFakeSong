# syntax=docker/dockerfile:1.7
# =====================================================================
# SpeechChecker — ambiente de treino: ssl-transformers (GPU)
# Requer NVIDIA Container Toolkit no host (Linux nativo ou Windows+WSL2).
# Mapa completo dos 5 ambientes: infrastructure/docker/environments/README.md
# =====================================================================
ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim

LABEL org.opencontainers.image.title="speechchecker-ssl-transformers" \
      org.opencontainers.image.description="SpeechChecker — treino SSL WavLM/HuBERT (NVIDIA GPU)" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/thierrybraga/XFakeSong"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    HF_HOME=/app/data/cache/huggingface \
    TORCH_HOME=/app/data/cache/torch \
    MPLBACKEND=Agg \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# requirements-base.txt precisa estar em /app para o `-r ../../../../requirements-base.txt`
# do arquivo do ambiente resolver; por isso o COPY preserva a estrutura.
COPY requirements-base.txt constraints.txt ./
COPY infrastructure/docker/environments/ssl-transformers/requirements.txt infrastructure/docker/environments/ssl-transformers/
ENV PIP_CONSTRAINT=/app/constraints.txt
RUN pip install --upgrade pip setuptools wheel \
    && pip install -r infrastructure/docker/environments/ssl-transformers/requirements.txt \
    && pip install 'tensorflow[and-cuda]>=2.16,<2.22' \
    && pip install --upgrade --no-deps 'nvidia-cudnn-cu12>=9.3.0.75,<10' \
    && pip install --no-deps 'nvidia-cuda-nvcc-cu12'

COPY . .

ENTRYPOINT ["tini", "--"]
CMD ["python", "tools/training/train_by_family.py", "--family", "ssl-transformers", "--help"]
